{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "VITE_ASTRA_DISABLE_MOCK=true pnpm build"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "astra_api.app:app",
      "installCommand": "pip install -r requirements-api.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
