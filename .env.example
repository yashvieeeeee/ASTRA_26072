# Public container port.
ASTRA_WEB_PORT=8080

# Mount this host directory at /app/artifacts. Set the following value to the
# corresponding container path only after a validated nowcast JSON is present.
ASTRA_ARTIFACTS_DIR=./artifacts
ASTRA_NOWCAST_ARTIFACT=

# Normally blank: the web container proxies same-origin API calls. Set only
# when exposing the API directly to approved browser origins.
ASTRA_CORS_ORIGINS=

# Optional, server-side credentials for click-scoped corroboration requests.
ASTRA_WEATHERBIT_KEY=
ASTRA_WEATHERAPI_KEY=
