{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASTRA ground_stations_pending source contract",
  "type": "object",
  "properties": {
    "source": {
      "const": "ground_stations_pending"
    },
    "spatial_representation": {
      "const": "point"
    },
    "is_synthetic": {
      "const": false
    },
    "pending_source": {
      "const": true
    },
    "variables": {
      "type": "array",
      "const": [
        "temperature_2m",
        "relative_humidity",
        "surface_pressure",
        "wind_speed_10m",
        "rainfall_rate"
      ]
    },
    "units": {
      "type": "object",
      "const": {
        "temperature_2m": "K",
        "relative_humidity": "%",
        "surface_pressure": "Pa",
        "wind_speed_10m": "m s-1",
        "rainfall_rate": "mm hr-1"
      }
    }
  },
  "required": [
    "source",
    "spatial_representation",
    "is_synthetic",
    "pending_source",
    "variables",
    "units"
  ],
  "additionalProperties": false,
  "xarray_required_dimensions": [
    "time",
    "point"
  ]
}